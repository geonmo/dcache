@@ -208,11 +223,63 @@ public class DCacheAwareJdbcFs extends JdbcFs implements CellIdentityAware {
         this.poolMonitor = poolMonitor;
     }
 
+    public void setSpaceLookupCache(LoadingCache<String, Optional<Space>> spaceLookupCache) {
+        this.spaceLookupCache = spaceLookupCache;
+    }
+
+    /**
+     * Sets the space token of the reservation used to report file system statistics. An empty
+     * value disables the feature.
+     */
+    public void setFsStatSpaceToken(String token) {
+        String trimmed = token == null ? "" : token.strip();
+        if (trimmed.isEmpty()) {
+            fsStatSpaceToken = null;
+            return;
+        }
+        try {
+            Long.parseLong(trimmed);
+        } catch (NumberFormatException e) {
+            throw new IllegalArgumentException("Invalid space token: " + token);
+        }
+        fsStatSpaceToken = trimmed;
+    }
+
     @Override
     public void setCellAddress(CellAddressCore address) {
         myAddress = address;
     }
 
+    /**
+     * Reports the size of the configured space reservation as total space and the space no longer
+     * available in that reservation (used and allocated) as used space. File counts are taken from
+     * the namespace. Falls back to namespace-wide statistics if no space token is configured or the
+     * reservation cannot be looked up.
+     */
+    @Override
+    public FsStat getFsStat() throws ChimeraFsException {
+        FsStat fsStat = super.getFsStat();
+        if (fsStatSpaceToken == null) {
+            return fsStat;
+        }
+
+        try {
+            Space space = spaceLookupCache.get(fsStatSpaceToken).orElse(null);
+            if (space != null) {
+                long size = space.getSizeInBytes();
+                long available = Math.max(0L, space.getAvailableSpaceInBytes());
+                return new FsStat(size, fsStat.getTotalFiles(), size - available,
+                      fsStat.getUsedFiles());
+            }
+            LOGGER.warn("Space reservation {} not found; reporting namespace statistics.",
+                  fsStatSpaceToken);
+        } catch (ExecutionException | UncheckedExecutionException e) {
+            LOGGER.warn("Failed to look up space reservation {}: {}", fsStatSpaceToken,
+                  e.getCause().getMessage());
+        }
+        return fsStat;
+    }
+
     @Override
     public String getFileLocality(FsInode_PLOC node) throws ChimeraFsException {
         FsInode pathInode = new FsInode(DCacheAwareJdbcFs.this, node.ino());
