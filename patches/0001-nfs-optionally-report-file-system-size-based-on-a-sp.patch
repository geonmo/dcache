+import java.io.InputStream;
+import java.net.URL;
+import java.sql.Connection;
+import java.util.Optional;
+import java.util.Properties;
+import liquibase.Liquibase;
+import liquibase.database.Database;
+import liquibase.database.DatabaseFactory;
+import liquibase.database.jvm.JdbcConnection;
+import liquibase.resource.ClassLoaderResourceAccessor;
+import org.junit.After;
+import org.junit.Before;
+import org.junit.Test;
+import org.springframework.jdbc.datasource.DataSourceTransactionManager;
+
+public class DCacheAwareJdbcFsTest {
+
+    private static final URL DB_TEST_PROPERTIES =
+          Resources.getResource("org/dcache/chimera/chimera-test.properties");
+
+    private HikariDataSource dataSource;
+    private DCacheAwareJdbcFs fs;
+    private FsStat namespaceStat;
+
+    @Before
+    public void setUp() throws Exception {
+        Properties dbProperties = new Properties();
+        try (InputStream input = Resources.asByteSource(DB_TEST_PROPERTIES).openStream()) {
+            dbProperties.load(input);
+        }
+
+        dataSource = FsFactory.getDataSource(
+              dbProperties.getProperty("chimera.db.url"),
+              dbProperties.getProperty("chimera.db.user"),
+              dbProperties.getProperty("chimera.db.password"));
+
+        try (Connection conn = dataSource.getConnection()) {
+            Database database = DatabaseFactory.getInstance()
+                  .findCorrectDatabaseImplementation(new JdbcConnection(conn));
+            Liquibase liquibase = new Liquibase("org/dcache/chimera/changelog/changelog-master.xml",
+                  new ClassLoaderResourceAccessor(), database);
+            liquibase.update("");
+        }
+
+        fs = new DCacheAwareJdbcFs(dataSource, new DataSourceTransactionManager(dataSource),
+              "strong");
+        namespaceStat = fs.getFsStat();
+    }
+
+    @After
+    public void tearDown() throws Exception {
+        try (Connection conn = dataSource.getConnection()) {
+            conn.createStatement().execute("SHUTDOWN;");
+        }
+        dataSource.close();
+        fs.close();
+    }
+
+    @Test
+    public void shouldReportNamespaceStatisticsWithoutSpaceToken() throws Exception {
+        fs.setFsStatSpaceToken("");
+
+        assertEquals(JdbcFs.AVAILABLE_SPACE, fs.getFsStat().getTotalSpace());
+    }
+
+    @Test
+    public void shouldReportSpaceReservationSizeAndUsage() throws Exception {
+        givenSpaceLookup(token -> Optional.of(space(1000, 300, 200)));
+        fs.setFsStatSpaceToken("42");
+
+        FsStat stat = fs.getFsStat();
+
+        assertEquals(1000, stat.getTotalSpace());
+        assertEquals(500, stat.getUsedSpace());
+        assertEquals(namespaceStat.getTotalFiles(), stat.getTotalFiles());
+        assertEquals(namespaceStat.getUsedFiles(), stat.getUsedFiles());
+    }
+
+    @Test
+    public void shouldNotReportMoreUsedThanTotalSpace() throws Exception {
+        givenSpaceLookup(token -> Optional.of(space(100, 80, 50)));
+        fs.setFsStatSpaceToken("42");
+
+        FsStat stat = fs.getFsStat();
+
+        assertEquals(100, stat.getTotalSpace());
+        assertEquals(100, stat.getUsedSpace());
+    }
+
+    @Test
+    public void shouldFallBackIfSpaceReservationNotFound() throws Exception {
+        givenSpaceLookup(token -> Optional.empty());
+        fs.setFsStatSpaceToken("42");
+
+        assertEquals(JdbcFs.AVAILABLE_SPACE, fs.getFsStat().getTotalSpace());
+    }
+
+    @Test
+    public void shouldFallBackIfSpaceManagerFails() throws Exception {
+        fs.setSpaceLookupCache(CacheBuilder.newBuilder().build(new CacheLoader<>() {
+            @Override
+            public Optional<Space> load(String token) throws Exception {
+                throw new TimeoutCacheException("timeout");
+            }
+        }));
+        fs.setFsStatSpaceToken("42");
+
+        assertEquals(JdbcFs.AVAILABLE_SPACE, fs.getFsStat().getTotalSpace());
+    }
+
+    @Test(expected = IllegalArgumentException.class)
+    public void shouldRejectNonNumericSpaceToken() {
+        fs.setFsStatSpaceToken("CMS_DISK");
+    }
+
+    private void givenSpaceLookup(
+          com.google.common.base.Function<String, Optional<Space>> lookup) {
+        LoadingCache<String, Optional<Space>> cache =
+              CacheBuilder.newBuilder().build(CacheLoader.from(lookup));
+        fs.setSpaceLookupCache(cache);
+    }
+
+    private static Space space(long size, long used, long allocated) {
+        return new Space(42, null, null, RetentionPolicy.REPLICA, AccessLatency.ONLINE, 1, size,
+              0, null, "test", SpaceState.RESERVED, used, allocated);
+    }
+}
