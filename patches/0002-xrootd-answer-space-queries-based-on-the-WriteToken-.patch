+/**
+ * Unit tests for {@link XrootdDoor#getWriteTokenSpace} and
+ * {@link XrootdRedirectHandler#toSpaceInfo}, which back kXR_Qspace queries.
+ */
+public class XrootdDoorSpaceQueryTest {
+
+    private static final FsPath PATH = FsPath.create("/data/cms");
+
+    private CellStub pnfsCellStub;
+    private XrootdDoor door;
+    private Subject subject;
+
+    @Before
+    public void setUp() {
+        pnfsCellStub = mock(CellStub.class);
+
+        door = new XrootdDoor();
+        door.setPnfsHandler(new PnfsHandler(pnfsCellStub));
+        door.setSpaceReservationEnabled(true);
+
+        subject = Subjects.of(1000, 1000, new int[]{1000});
+    }
+
+    @Test
+    public void shouldReturnSpaceOfWriteToken() throws Exception {
+        Space space = space(1000, 300, 200);
+        givenWriteToken("42");
+        givenSpaceLookup(token -> token.equals("42") ? Optional.of(space) : Optional.empty());
+
+        assertThat(door.getWriteTokenSpace(PATH, subject, Restrictions.none()),
+              is(sameInstance(space)));
+    }
+
+    @Test
+    public void shouldFailWithoutWriteToken() {
+        givenWriteToken(null);
+        givenSpaceLookup(token -> Optional.empty());
+
+        CacheException e = assertThrows(CacheException.class,
+              () -> door.getWriteTokenSpace(PATH, subject, Restrictions.none()));
+        assertThat(e.getRc(), is(CacheException.INVALID_ARGS));
+    }
+
+    @Test
+    public void shouldFailIfSpaceReservationNotFound() {
+        givenWriteToken("42");
+        givenSpaceLookup(token -> Optional.empty());
+
+        assertThrows(CacheException.class,
+              () -> door.getWriteTokenSpace(PATH, subject, Restrictions.none()));
+    }
+
+    @Test
+    public void shouldPropagateSpaceManagerFailure() {
+        givenWriteToken("42");
+        door.setSpaceLookupCache(CacheBuilder.newBuilder().build(new CacheLoader<>() {
+            @Override
+            public Optional<Space> load(String token) throws Exception {
+                throw new TimeoutCacheException("timeout");
+            }
+        }));
+
+        assertThrows(TimeoutCacheException.class,
+              () -> door.getWriteTokenSpace(PATH, subject, Restrictions.none()));
+    }
+
+    @Test
+    public void shouldFormatSpaceInfoLikeXrootdOss() {
+        assertThat(XrootdRedirectHandler.toSpaceInfo(space(1000, 300, 200)),
+              is("oss.cgroup=42&oss.space=1000&oss.free=500&oss.maxf=500"
+                    + "&oss.used=500&oss.quota=1000"));
+    }
+
+    @Test
+    public void shouldNotReportNegativeFreeSpace() {
+        assertThat(XrootdRedirectHandler.toSpaceInfo(space(100, 80, 50)),
+              is("oss.cgroup=42&oss.space=100&oss.free=0&oss.maxf=0"
+                    + "&oss.used=100&oss.quota=100"));
+    }
+
+    private void givenWriteToken(String token) {
+        when(pnfsCellStub.send(any(PnfsGetFileAttributes.class), anyLong()))
+              .thenAnswer(invocation -> {
+                  PnfsGetFileAttributes request = invocation.getArgument(0);
+                  GenericStorageInfo storageInfo = new GenericStorageInfo();
+                  if (token != null) {
+                      storageInfo.setKey("writeToken", token);
+                  }
+                  FileAttributes attributes = new FileAttributes();
+                  attributes.setStorageInfo(storageInfo);
+                  request.setFileAttributes(attributes);
+                  return Futures.immediateFuture(request);
+              });
+    }
+
+    private void givenSpaceLookup(Function<String, Optional<Space>> lookup) {
+        door.setSpaceLookupCache(CacheBuilder.newBuilder().build(CacheLoader.from(lookup)));
+    }
+
+    private static Space space(long size, long used, long allocated) {
+        return new Space(42, null, null, RetentionPolicy.REPLICA, AccessLatency.ONLINE, 1, size,
+              0, null, "test", SpaceState.RESERVED, used, allocated);
+    }
+}
