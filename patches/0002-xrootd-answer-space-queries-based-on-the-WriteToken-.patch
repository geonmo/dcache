+    /**
+     * Reports the space reservation of the queried path, as given by its WriteToken directory
+     * tag, in the format used by xrootd's oss plugin.
+     */
+    private QueryResponse querySpace(QueryRequest msg) throws XrootdException {
+        String args = msg.getArgs();
+        int pos = args.indexOf(XrootdProtocol.OPAQUE_DELIMITER);
+        String path = pos > -1 ? args.substring(0, pos) : args;
+        String opaque = pos > -1 ? args.substring(pos + 1) : "";
+        if (path.isEmpty()) {
+            throw new XrootdException(kXR_ArgMissing, "no path specified");
+        }
+
+        try {
+            LoginSessionInfo loginSessionInfo = sessionInfo();
+            Space space = _door.getWriteTokenSpace(
+                  createFullPath(path, safelyExtractOpaque(opaque)),
+                  loginSessionInfo.getSubject(),
+                  loginSessionInfo.getRestriction());
+            return new QueryResponse(msg, toSpaceInfo(space));
+        } catch (CacheException e) {
+            throw xrootdException(e);
+        }
+    }
+
+    static String toSpaceInfo(Space space) {
+        long size = space.getSizeInBytes();
+        long free = Math.max(0L, space.getAvailableSpaceInBytes());
+        return "oss.cgroup=" + space.getId()
+              + "&oss.space=" + size
+              + "&oss.free=" + free
+              + "&oss.maxf=" + free
+              + "&oss.used=" + (size - free)
+              + "&oss.quota=" + size;
+    }
+
